---
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { formatDistance, formatWorkoutDate } from "@/lib/format";
import { roundLoad } from "@/lib/training-load";
import { cn } from "@/lib/utils";
import type { Workout } from "@/types";

interface Props {
  email: string | undefined;
  weeklyLoad: number | null;
  workouts: Workout[];
  listError: string | null;
  /** Success notice shown above the list (e.g. after a delete or an edit). */
  notice?: string;
}

const { email, weeklyLoad, workouts, listError, notice } = Astro.props;

const loadFormatter = new Intl.NumberFormat("pl-PL", { maximumFractionDigits: 0 });
---

<Card className="mx-auto w-full max-w-lg gap-0 rounded-2xl p-6 backdrop-blur-xl sm:p-8">
  <h1 class="text-xl font-bold sm:text-2xl">Twoje treningi</h1>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <p class="text-muted-foreground min-w-0 truncate text-sm">
      Zalogowano jako <span class="text-foreground font-semibold">{email}</span>
    </p>
    <form method="POST" action="/api/auth/signout">
      <button type="submit" class:list={buttonVariants({ variant: "outline", size: "sm" })}>
        Wyloguj
      </button>
    </form>
  </div>

  {weeklyLoad !== null && (
    <div class="bg-muted mt-6 rounded-lg border px-4 py-3">
      <p class="text-muted-foreground text-sm">Obciążenie z ostatnich 7 dni</p>
      <p class="mt-1 text-3xl font-bold" data-testid="weekly-load">
        {loadFormatter.format(roundLoad(weeklyLoad))}
      </p>
      <p class="text-muted-foreground/75 mt-1 text-xs">Suma z treningów: dystans (km) × średnie tętno ÷ 100</p>
    </div>
  )}

  <div class="mt-6 flex flex-col gap-3 sm:flex-row">
    <a href="/dashboard/workouts/new" class:list={cn(buttonVariants(), "w-full sm:flex-1")}>
      Dodaj trening
    </a>
    <a href="#treningi" class:list={cn(buttonVariants({ variant: "outline" }), "w-full sm:flex-1")}>
      Edytuj trening
    </a>
    <a href="/dashboard/suggestion" class:list={cn(buttonVariants({ variant: "outline" }), "w-full sm:flex-1")}>
      Sugestia na dziś
    </a>
  </div>

  <h2 id="treningi" class="mt-8 mb-4 text-lg font-semibold sm:text-xl">
    Ostatnie 7 dni
  </h2>

  {notice && (
    <Alert className="mb-4">
      <AlertDescription>{notice}</AlertDescription>
    </Alert>
  )}

  {listError ? (
    <Alert variant="destructive">
      <AlertDescription>{listError}</AlertDescription>
    </Alert>
  ) : workouts.length === 0 ? (
    <div class="flex flex-wrap items-center gap-x-2">
      <p class="text-muted-foreground/75 text-sm">Brak treningów z ostatnich 7 dni.</p>
      <a href="/dashboard/workouts/new" class:list={buttonVariants({ variant: "link" })}>
        Dodaj pierwszy trening
      </a>
    </div>
  ) : (
    <ul class="space-y-2">
      {workouts.map((workout) => (
        <li class="bg-muted flex items-start justify-between gap-3 rounded-lg border px-4 py-3">
          <div class="min-w-0">
            <p class="font-medium">{formatWorkoutDate(workout.workout_date)}</p>
            <p class="text-muted-foreground mt-1 text-sm">
              {formatDistance(workout.distance_km)} km · śr. tętno {workout.avg_heart_rate} ud/min
            </p>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <a
              href={`/dashboard/workouts/${encodeURIComponent(workout.id)}/edit`}
              aria-label={`Edytuj trening z ${formatWorkoutDate(workout.workout_date)}`}
              class:list={cn(buttonVariants({ variant: "link", size: "sm" }), "px-0")}
            >
              Edytuj
            </a>
            <a
              href={`/dashboard/workouts/${encodeURIComponent(workout.id)}/delete`}
              aria-label={`Usuń trening z ${formatWorkoutDate(workout.workout_date)}`}
              class:list={cn(buttonVariants({ variant: "link", size: "sm" }), "px-0")}
            >
              Usuń
            </a>
          </div>
        </li>
      ))}
    </ul>
  )}
</Card>
