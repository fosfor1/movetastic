---
import Layout from "@/layouts/Layout.astro";
import DashboardView from "@/components/dashboard/DashboardView.astro";
import { createClient } from "@/lib/supabase";
import { todayInAppTimeZone } from "@/lib/dates";
import { listRecentWorkouts } from "@/lib/workouts";
import { weeklyTrainingLoad } from "@/lib/training-load";
import type { Workout } from "@/types";

const { user } = Astro.locals;

let workouts: Workout[] = [];
let listError: string | null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  listError = "Nie można wczytać treningów: Supabase nie jest skonfigurowany.";
} else {
  const result = await listRecentWorkouts(supabase, todayInAppTimeZone());
  workouts = result.data;
  listError = result.error;
}

const weeklyLoad = listError ? null : weeklyTrainingLoad(workouts);
// Set by POST /api/workouts/:id/delete; only the exact value shows the notice.
const notice = Astro.url.searchParams.get("deleted") === "1" ? "Trening usunięty." : undefined;
---

<Layout title="Twoje treningi">
  <div class="bg-cosmic min-h-screen p-4">
    <DashboardView
      email={user?.email}
      weeklyLoad={weeklyLoad}
      workouts={workouts}
      listError={listError}
      notice={notice}
    />
  </div>
</Layout>
